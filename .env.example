# Database
DATABASE_URL=

# Application
APP_BASE_URL=http://localhost:3000
ADMIN_API_SECRET=replace-with-long-random-secret

# Strict zero-spend guard
MONTHLY_BUDGET_INR=0
WHATSAPP_API_SEND_ENABLED=false

# Meta Cloud API (leave blank until officially onboarded)
META_GRAPH_VERSION=vXX.X
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# n8n
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# S3-compatible private object storage (e.g. Cloudflare R2)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Bilingual hybrid auto-reply (default OFF). Enable only after Meta setup and budget review.
WHATSAPP_AUTO_REPLY_ENABLED=false
# Meta currently provides 1,000 monthly free service messages per business number (Oct 2026 policy); hard cap never exceeds 1,000.
FREE_SERVICE_MESSAGE_CAP=1000
